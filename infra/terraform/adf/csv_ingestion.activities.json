[
  {
    "name": "NormalizeLandingFolder",
    "type": "SetVariable",
    "typeProperties": {
      "variableName": "relativeDir",
      "value": {
        "value": "@replace(replace(concat(pipeline().parameters.folderPath, '/'), '/landing/blobs/', ''), 'landing/', '')",
        "type": "Expression"
      }
    }
  },
  {
    "name": "BuildRelativePath",
    "type": "SetVariable",
    "dependsOn": [{ "activity": "NormalizeLandingFolder", "dependencyConditions": ["Succeeded"] }],
    "typeProperties": {
      "variableName": "relativePath",
      "value": {
        "value": "@concat(variables('relativeDir'), pipeline().parameters.fileName)",
        "type": "Expression"
      }
    }
  },
  {
    "name": "GetInputETag",
    "type": "WebActivity",
    "dependsOn": [{ "activity": "BuildRelativePath", "dependencyConditions": ["Succeeded"] }],
    "policy": {
      "timeout": "0.00:02:00",
      "retry": 2,
      "retryIntervalInSeconds": 30,
      "secureOutput": false,
      "secureInput": false
    },
    "typeProperties": {
      "method": "GET",
      "url": {
        "value": "@concat('https://\u0024{storage_account_name}.dfs.core.windows.net/landing/', replace(encodeUriComponent(variables('relativePath')), '%2F', '/'), '?action=getStatus')",
        "type": "Expression"
      },
      "headers": {
        "x-ms-version": "2020-10-02"
      },
      "authentication": {
        "type": "MSI",
        "resource": "https://storage.azure.com"
      }
    }
  },
  {
    "name": "ValidateCsv",
    "type": "AzureFunctionActivity",
    "dependsOn": [{ "activity": "GetInputETag", "dependencyConditions": ["Succeeded"] }],
    "policy": {
      "timeout": "0.00:02:00",
      "retry": 2,
      "retryIntervalInSeconds": 30,
      "secureOutput": false,
      "secureInput": false
    },
    "typeProperties": {
      "functionName": "validate",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "filesystem": "landing",
        "path": "@variables('relativePath')",
        "etag": "@concat('\"', coalesce(activity('GetInputETag').output.PathStatus?.etag, activity('GetInputETag').output.PathStatus?.eTag, activity('GetInputETag').output.pathStatus?.etag, activity('GetInputETag').output.pathStatus?.eTag, ''), '\"')"
      }
    },
    "linkedServiceName": {
      "referenceName": "ls-function-validator",
      "type": "LinkedServiceReference"
    }
  },
  {
    "name": "RouteByStatus",
    "type": "Switch",
    "dependsOn": [{ "activity": "ValidateCsv", "dependencyConditions": ["Succeeded"] }],
    "typeProperties": {
      "on": {
        "value": "@activity('ValidateCsv').output.status",
        "type": "Expression"
      },
      "cases": [
        {
          "value": "VALID",
          "activities": [
            {
              "name": "CopyToValidated",
              "type": "Copy",
              "policy": {
                "timeout": "0.00:10:00",
                "retry": 1,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": { "type": "BinarySource", "storeSettings": { "type": "AzureBlobFSReadSettings", "recursive": false } },
                "sink": { "type": "BinarySink", "storeSettings": { "type": "AzureBlobFSWriteSettings" } }
              },
              "inputs": [{
                "referenceName": "ds-adls-binary",
                "type": "DatasetReference",
                "parameters": {
                  "fileSystem": "landing",
                  "folderPath": "@variables('relativeDir')",
                  "fileName": "@pipeline().parameters.fileName"
                }
              }],
              "outputs": [{
                "referenceName": "ds-adls-binary",
                "type": "DatasetReference",
                "parameters": {
                  "fileSystem": "validated",
                  "folderPath": "@variables('relativeDir')",
                  "fileName": "@pipeline().parameters.fileName"
                }
              }]
            },
            {
              "name": "TransformOrders",
              "type": "ExecuteDataFlow",
              "dependsOn": [{ "activity": "CopyToValidated", "dependencyConditions": ["Succeeded"] }],
              "policy": {
                "timeout": "0.00:30:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "dataflow": {
                  "referenceName": "df-transform-orders",
                  "type": "DataFlowReference",
                  "datasetParameters": {
                    "source1": {
                      "fileSystem": "validated",
                      "folderPath": "@variables('relativeDir')",
                      "fileName": "@pipeline().parameters.fileName"
                    },
                    "sink1": {
                      "fileSystem": "output",
                      "folderPath": "@variables('relativeDir')",
                      "fileName": "@pipeline().parameters.fileName"
                    }
                  }
                },
                "compute": { "coreCount": 8, "computeType": "General" },
                "integrationRuntime": {
                  "referenceName": "\u0024{ir_name}",
                  "type": "IntegrationRuntimeReference"
                }
              }
            }
          ]
        },
        {
          "value": "INVALID",
          "activities": [
            {
              "name": "CopyToRejected",
              "type": "Copy",
              "policy": {
                "timeout": "0.00:10:00",
                "retry": 1,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": { "type": "BinarySource", "storeSettings": { "type": "AzureBlobFSReadSettings", "recursive": false } },
                "sink": { "type": "BinarySink", "storeSettings": { "type": "AzureBlobFSWriteSettings" } }
              },
              "inputs": [{
                "referenceName": "ds-adls-binary",
                "type": "DatasetReference",
                "parameters": {
                  "fileSystem": "landing",
                  "folderPath": "@variables('relativeDir')",
                  "fileName": "@pipeline().parameters.fileName"
                }
              }],
              "outputs": [{
                "referenceName": "ds-adls-binary",
                "type": "DatasetReference",
                "parameters": {
                  "fileSystem": "rejected",
                  "folderPath": "@variables('relativeDir')",
                  "fileName": "@pipeline().parameters.fileName"
                }
              }]
            },
            {
              "name": "SaveValidationResult",
              "type": "WebActivity",
              "dependsOn": [{ "activity": "CopyToRejected", "dependencyConditions": ["Succeeded"] }],
              "policy": {
                "timeout": "0.00:02:00",
                "retry": 2,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "method": "PUT",
                "url": {
                  "value": "@concat('https://\u0024{storage_account_name}.blob.core.windows.net/rejected/', replace(encodeUriComponent(concat(variables('relativePath'), '.validation.json')), '%2F', '/'))",
                  "type": "Expression"
                },
                "headers": {
                  "x-ms-version": "2020-10-02",
                  "x-ms-blob-type": "BlockBlob",
                  "Content-Type": "application/json"
                },
                "body": {
                  "sourcePath": "@variables('relativePath')",
                  "status": "@activity('ValidateCsv').output.status",
                  "errorCount": "@activity('ValidateCsv').output.errorCount",
                  "errors": "@activity('ValidateCsv').output.errors"
                },
                "authentication": {
                  "type": "MSI",
                  "resource": "https://storage.azure.com"
                }
              }
            }
          ]
        }
      ],
      "defaultActivities": [
        {
          "name": "UnexpectedStatus",
          "type": "Fail",
          "typeProperties": {
            "message": {
              "value": "@concat('検証結果が想定外です: ', string(activity('ValidateCsv').output))",
              "type": "Expression"
            },
            "errorCode": "UNEXPECTED_VALIDATION_STATUS"
          }
        }
      ]
    }
  }
]

